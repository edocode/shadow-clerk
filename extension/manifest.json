{
  "manifest_version": 3,
  "name": "shadow-clerk screenshot",
  "version": "1.0.0",
  "description": "表示中のタブをキャプチャして shadow-clerk に保存し、記録中の transcript に1行残す",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "shadow-clerk に画面を保存" }
}
